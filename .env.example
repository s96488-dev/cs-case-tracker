# --- cloud (.env next to docker-compose.yml) ---
# Long random token: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=replace-with-a-random-token
# Domain for HTTPS. Without your own domain, a free one like 34-123-45-67.sslip.io works (VM IP with dashes).
DOMAIN=34-123-45-67.sslip.io
STEAM_INTERVAL=60
RETENTION_HOURS=72
MAX_DAYS=60
# Steam refresh token (steamRefresh_steam cookie) for sales history, see README "Steam token".
# Easiest to set with the script: sh deploy/set-steam-token.sh. Empty - sales history is not collected.
STEAM_REFRESH_TOKEN=
