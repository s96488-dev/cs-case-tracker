# --- облако (.env рядом с docker-compose.yml) ---
# Длинный случайный токен: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=замените-на-случайный-токен
# Домен для HTTPS. Без своего домена подойдёт бесплатный вида 34-123-45-67.sslip.io (IP вашей VM через дефисы).
DOMAIN=34-123-45-67.sslip.io
STEAM_INTERVAL=60
RETENTION_HOURS=72
MAX_DAYS=60
